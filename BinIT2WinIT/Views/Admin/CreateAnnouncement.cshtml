@model BinIT2WinIT.Models.Announcement

@{
    ViewBag.Title = "Create Announcement";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4><i class="fas fa-bullhorn"></i> Create Announcement</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("CreateAnnouncement", "Admin", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Title, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "Announcement title" })
                            @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Message, new { @class = "form-label fw-semibold" })
                            @Html.TextAreaFor(m => m.Message, new { @class = "form-control", rows = 4, placeholder = "Enter announcement message" })
                            @Html.ValidationMessageFor(m => m.Message, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.RewardType, new { @class = "form-label fw-semibold" })
                            @Html.DropDownListFor(m => m.RewardType,
                                new SelectList(new[] { "General", "Voucher", "CommunityReward" }),
                                "-- Select Reward Type --",
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.RewardType, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.TargetAudience, new { @class = "form-label fw-semibold" })
                            @Html.DropDownListFor(m => m.TargetAudience,
                                new SelectList(new[] { "All", "Residents", "CollectionOfficers", "Administrators" }),
                                "-- Select Audience --",
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.TargetAudience, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.MinPointsRequired, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.MinPointsRequired, new { @class = "form-control", placeholder = "Points required (e.g. 500)" })
                            @Html.ValidationMessageFor(m => m.MinPointsRequired, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.VoucherCode, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.VoucherCode, new { @class = "form-control", placeholder = "Voucher code (if applicable)" })
                            @Html.ValidationMessageFor(m => m.VoucherCode, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.CommunityReward, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.CommunityReward, new { @class = "form-control", placeholder = "e.g. Park Makeover, New Playground, etc." })
                            @Html.ValidationMessageFor(m => m.CommunityReward, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.EndDate, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
                        </div>

                        <div class="mt-3">
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-save"></i> Create Announcement
                            </button>
                            @Html.ActionLink("Cancel", "Announcements", "Admin", null, new { @class = "btn btn-secondary ms-2" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

