@model IEnumerable<BinIT2WinIT.Models.RedemptionRequest>

@{
    ViewBag.Title = "Export Redemptions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-file-export text-success"></i> Export Redemptions</h2>
    <hr />

    <div class="row mb-3">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h5><i class="fas fa-download"></i> Export Options</h5>
                    <p class="text-muted">Export redemption records for reporting purposes.</p>

                    <div class="btn-group" role="group">
                        <button class="btn btn-success" onclick="exportCSV()">
                            <i class="fas fa-file-csv"></i> Export CSV
                        </button>
                        <button class="btn btn-primary" onclick="exportPDF()">
                            <i class="fas fa-file-pdf"></i> Export PDF
                        </button>
                        <button class="btn btn-info" onclick="exportExcel()">
                            <i class="fas fa-file-excel"></i> Export Excel
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-body">
                    <h5><i class="fas fa-info-circle"></i> Summary</h5>
                    <div class="row">
                        <div class="col-6">
                            <strong>Total Redemptions:</strong>
                            <span class="badge bg-primary">@Model.Count()</span>
                        </div>
                        <div class="col-6">
                            <strong>Total Value:</strong>
                            <span class="badge bg-success">R@(Model.Sum(r => r.DiscountAmount).ToString("0.00"))</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Redemptions Table -->
    <div class="card shadow">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="fas fa-list"></i> Approved Redemptions</h5>
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered" id="redemptionsTable">
                        <thead class="bg-dark text-white">
                            <tr>
                                <th>Reference</th>
                                <th>Resident</th>
                                <th>Utility Type</th>
                                <th>Points Used</th>
                                <th>Discount</th>
                                <th>Request Date</th>
                                <th>Approved Date</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model)
                            {
                                <tr>
                                    <td><code>@request.ReferenceNumber</code></td>
                                    <td>@request.Resident?.FullName</td>
                                    <td>@request.UtilityType</td>
                                    <td>@request.PointsUsed</td>
                                    <td>R@(request.DiscountAmount.ToString("0.00"))</td>
                                    <td>@request.RequestDate.ToShortDateString()</td>
                                    <td>@(request.ApprovedDate?.ToShortDateString() ?? "-")</td>
                                    <td>
                                        <span class="badge bg-success">@request.RequestStatus</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No approved redemptions found.
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        @Html.ActionLink("← Back to Dashboard", "Dashboard", "Admin", null, new { @class = "btn btn-secondary" })
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
        transition: transform 0.2s;
        border: none;
    }

        .card:hover {
            transform: translateY(-2px);
        }

    .btn-group .btn {
        border-radius: 8px;
        margin: 0 5px;
        padding: 10px 20px;
    }

    .table th {
        vertical-align: middle;
    }

    code {
        background-color: #f4f4f4;
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 0.9em;
    }
</style>

@section Scripts {
    <script>
        function exportCSV() {
            alert('CSV export functionality coming soon!');
            // You can implement CSV export here
        }

        function exportPDF() {
            alert('PDF export functionality coming soon!');
            // You can implement PDF export here
        }

        function exportExcel() {
            alert('Excel export functionality coming soon!');
            // You can implement Excel export here
        }
    </script>
}