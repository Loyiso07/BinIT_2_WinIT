@model IEnumerable<BinIT2WinIT.Models.Announcement>

@{
    ViewBag.Title = "Announcements";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center">
        <h2><i class="fas fa-bullhorn text-warning"></i> Announcements</h2>
        @Html.ActionLink("+ Create Announcement", "CreateAnnouncement", "Admin", null, new { @class = "btn btn-success" })
    </div>
    <hr />

    <div class="card shadow">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <div class="card mb-3 @(item.IsActive ? "border-success" : "border-secondary")">
                        <div class="card-header d-flex justify-content-between align-items-center @(item.IsActive ? "bg-success text-white" : "bg-secondary text-white")">
                            <h5 class="mb-0">@item.Title</h5>
                            <div>
                                @if (item.RewardType == "Voucher")
                                {
                                    <span class="badge bg-warning text-dark"><i class="fas fa-ticket-alt"></i> Voucher</span>
                                }
                                else if (item.RewardType == "CommunityReward")
                                {
                                    <span class="badge bg-info"><i class="fas fa-city"></i> Community Reward</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark">General</span>
                                }
                                <span class="badge @(item.IsActive ? "bg-light text-success" : "bg-secondary")">
                                    @(item.IsActive ? "Active" : "Inactive")
                                </span>
                            </div>
                        </div>
                        <div class="card-body">
                            <p>@item.Message</p>
                            @if (item.MinPointsRequired.HasValue)
                            {
                                <p><strong>Minimum Points Required:</strong> @item.MinPointsRequired pts</p>
                            }
                            @if (!string.IsNullOrEmpty(item.VoucherCode))
                            {
                                <p><strong>Voucher Code:</strong> <code>@item.VoucherCode</code></p>
                            }
                            @if (!string.IsNullOrEmpty(item.CommunityReward))
                            {
                                <p><strong>Community Reward:</strong> 🎉 @item.CommunityReward</p>
                            }
                            <small class="text-muted">
                                <i class="fas fa-calendar-alt"></i> @item.StartDate.ToShortDateString()
                                @if (item.EndDate.HasValue)
                                {
                                    <span> - @item.EndDate.Value.ToShortDateString()</span>
                                }
                            </small>
                            <br />
                            <small class="text-muted"><i class="fas fa-user"></i> By: @item.CreatedBy</small>
                        </div>
                        <div class="card-footer">
                            @using (Html.BeginForm("DeleteAnnouncement", "Admin", FormMethod.Post, new { style = "display:inline;" }))
                            {
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.AnnouncementId" />
                                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Delete this announcement?')">
                                    <i class="fas fa-trash"></i> Delete
                                </button>
                            }
                        </div>
                    </div>
                }
            }
            else
            {
                <p class="text-muted">No announcements yet. Create one to inform users about rewards!</p>
            }
        </div>
    </div>

    <div class="mt-3">
        @Html.ActionLink("← Back to Dashboard", "Dashboard", "Admin", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>

