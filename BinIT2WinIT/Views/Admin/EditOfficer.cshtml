@model BinIT2WinIT.Models.CollectionOfficer

@{
    ViewBag.Title = "Edit Officer";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <h4><i class="fas fa-edit"></i> Edit Officer</h4>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }

                    @using (Html.BeginForm("EditOfficer", "Admin", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        @Html.HiddenFor(m => m.OfficerId)
                        @Html.HiddenFor(m => m.UserId)

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.EmployeeNumber, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.EmployeeNumber, new { @class = "form-control", @readonly = "readonly" })
                            @Html.ValidationMessageFor(m => m.EmployeeNumber, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Department, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.Department, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Department, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.DropOffPointId, new { @class = "form-label fw-semibold" })
                            @Html.DropDownListFor(m => m.DropOffPointId,
                                (SelectList)ViewBag.DropOffPoints,
                                "-- Select Region --",
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.DropOffPointId, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            <div class="form-check form-switch">
                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                                @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                            </div>
                            @Html.ValidationMessageFor(m => m.IsActive, "", new { @class = "text-danger" })
                        </div>

                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                            @Html.ActionLink("Cancel", "Officers", "Admin", null, new { @class = "btn btn-secondary ms-2" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

