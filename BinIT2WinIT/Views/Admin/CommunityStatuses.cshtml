@model IEnumerable<BinIT2WinIT.Models.CommunityStatus>

@{
    ViewBag.Title = "Community Statuses";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-city text-info"></i> Community Status Overview</h2>
    <p class="text-muted">View all community status updates from Collection Officers</p>
    <hr />

    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <i class="fas fa-list"></i> All Community Statuses
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Community</th>
                                <th>Status</th>
                                <th>Notes</th>
                                <th>Updated By</th>
                                <th>Last Updated</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var status in Model)
                            {
                                <tr>
                                    <td><strong>@(status.DropOffPoint?.Name ?? "Unknown")</strong></td>
                                    <td>
                                        <span class="badge @(status.Status == "Active" ? "bg-success" : status.Status == "NeedsAttention" ? "bg-warning" : status.Status == "Critical" ? "bg-danger" : "bg-secondary")">
                                            @status.Status
                                        </span>
                                    </td>
                                    <td>@status.Notes</td>
                                    <td>@status.UpdatedBy</td>
                                    <td>@status.UpdatedDate.ToString("dd MMM yyyy HH:mm")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i>
                    No community status updates yet. Officers will update them from their dashboard.
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        @Html.ActionLink("← Back to Dashboard", "Dashboard", "Admin", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>

