@model BinIT2WinIT.Models.DropOffPoint

@{
    ViewBag.Title = "Community Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-city text-info"></i> Community Details</h2>
    <hr />

    <div class="row">
        <!-- Community Info -->
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <i class="fas fa-info-circle"></i> Community Information
                </div>
                <div class="card-body">
                    <p><strong>Name:</strong> @Model.Name</p>
                    <p><strong>Address:</strong> @Model.Address</p>
                    <p><strong>City:</strong> @Model.City</p>
                    <p><strong>Suburb:</strong> @Model.Suburb</p>
                    <p><strong>Contact Person:</strong> @Model.ContactPerson</p>
                    <p><strong>Phone:</strong> @Model.PhoneNumber</p>
                    <p>
                        <strong>Status:</strong>
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </p>
                </div>
            </div>
        </div>

        <!-- Latest Status -->
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <i class="fas fa-clipboard-check"></i> Latest Community Status
                </div>
                <div class="card-body">
                    @if (ViewBag.LatestStatus != null)
                    {
                        var status = (BinIT2WinIT.Models.CommunityStatus)ViewBag.LatestStatus;
                        <p>
                            <strong>Status:</strong>
                            <span class="badge @(status.Status == "Active" ? "bg-success" : status.Status == "NeedsAttention" ? "bg-warning" : status.Status == "Critical" ? "bg-danger" : "bg-secondary")">
                                @status.Status
                            </span>
                        </p>
                        <p><strong>Notes:</strong> @status.Notes</p>
                        <p><strong>Updated By:</strong> @status.UpdatedBy</p>
                        <p><strong>Last Updated:</strong> @status.UpdatedDate.ToString("dd MMM yyyy HH:mm")</p>
                    }
                    else
                    {
                        <p class="text-muted">No status update available for this community.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Stats -->
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card bg-success text-white shadow">
                <div class="card-body text-center">
                    <h4>@ViewBag.OfficerCount</h4>
                    <p>Officers</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-info text-white shadow">
                <div class="card-body text-center">
                    <h4>@ViewBag.SubmissionCount</h4>
                    <p>Submissions</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body text-center">
                    <h4>@ViewBag.TotalWeight.ToString("0.0") kg</h4>
                    <p>Total Weight</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-secondary text-white shadow">
                <div class="card-body text-center">
                    <h4>@ViewBag.TotalCO2.ToString("0.0") kg</h4>
                    <p>CO2 Saved</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Officers List -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <i class="fas fa-user-tie"></i> Assigned Officers
                </div>
                <div class="card-body">
                    @if (ViewBag.Officers != null && ((List<BinIT2WinIT.Models.CollectionOfficer>)ViewBag.Officers).Any())
                    {
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Employee Number</th>
                                    <th>Department</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var officer in ViewBag.Officers)
                                {
                                    <tr>
                                        <td>@officer.FullName</td>
                                        <td>@officer.EmployeeNumber</td>
                                        <td>@officer.Department</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <p class="text-muted">No officers assigned to this community.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        @Html.ActionLink("← Back to Communities", "Communities", "Admin", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>

