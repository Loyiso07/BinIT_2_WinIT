@using Microsoft.AspNet.Identity
@model List<BinIT2WinIT.Models.Administrator>

@{
    ViewBag.Title = "Manage Administrators";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-user-shield text-primary"></i> Manage Administrators</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3">
        <a href="@Url.Action("AddAdmin", "Admin")" class="btn btn-success">
            <i class="fas fa-user-plus"></i> Add New Admin
        </a>
        <a href="@Url.Action("AdminAudit", "Admin")" class="btn btn-info text-white">
            <i class="fas fa-history"></i> View Audit Log
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="bg-dark text-white">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Department</th>
                    <th>Created By</th>
                    <th>Created At</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var admin in Model)
                {
                    // Use ViewBag.CurrentUserId from controller
                    var isCurrentUser = admin.UserId == ViewBag.CurrentUserId;
                    <tr>
                        <td>@admin.FullName @(isCurrentUser ? "(You)" : "")</td>
                        <td>@admin.Email</td>
                        <td>@admin.Department</td>
                        <td>@(admin.CreatedByUser?.FullName ?? "System")</td>
                        <td>@admin.CreatedAt.ToShortDateString()</td>
                        <td>
                            @if (!isCurrentUser)
                            {
                                using (Html.BeginForm("RemoveAdmin", "Admin", FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("userId", admin.UserId)
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Remove this administrator?')">
                                        <i class="fas fa-user-minus"></i> Remove
                                    </button>
                                }
                            }
                            else
                            {
                                <span class="text-muted">Current user</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        @Html.ActionLink("← Back to Dashboard", "Dashboard", "Admin", null, new { @class = "btn btn-secondary" })
    </div>
</div>