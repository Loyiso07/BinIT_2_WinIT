@model List<BinIT2WinIT.Models.AdminCreationAudit>

@{
    ViewBag.Title = "Admin Audit Log";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-history text-info"></i> Admin Creation Audit Log</h2>
    <hr />

    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i> This log shows all administrator creation activity.
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="bg-dark text-white">
                    <tr>
                        <th>Date</th>
                        <th>New Admin Name</th>
                        <th>New Admin Email</th>
                        <th>Created By</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var audit in Model)
                    {
                        <tr>
                            <td>@audit.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                            <td>@audit.NewAdminName</td>
                            <td>@audit.NewAdminEmail</td>
                            <td>
                                <span class="badge bg-success">
                                    <i class="fas fa-user-check"></i> @audit.CreatedByName
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No admin creation records found.
        </div>
    }

    <div class="mt-3">
        @Html.ActionLink("← Back to Manage Admins", "ManageAdmins", "Admin", null, new { @class = "btn btn-secondary" })
    </div>
</div>