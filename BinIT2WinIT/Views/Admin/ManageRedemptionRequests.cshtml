@model IEnumerable<BinIT2WinIT.Models.RedemptionRequest>

@{
    ViewBag.Title = "Manage Redemption Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-tasks text-primary"></i> Manage Redemption Requests</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Pending Requests -->
    <div class="card shadow mb-4">
        <div class="card-header bg-warning text-dark">
            <i class="fas fa-clock"></i> Pending Requests (@Model.Count())
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Request ID</th>
                                <th>Date</th>
                                <th>Resident</th>
                                <th>Utility Type</th>
                                <th>Points Used</th>
                                <th>Discount Amount</th>
                                <th>Account Number</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model)
                            {
                                <tr>
                                    <td>@request.RequestId</td>
                                    <td>@request.RequestDate.ToShortDateString()</td>
                                    <!-- ✅ FIXED: Use Resident.FullName -->
                                    <td>@(request.Resident?.FullName ?? "Unknown")</td>
                                    <!-- ✅ FIXED: Use RedemptionOption.UtilityType -->
                                    <td>@(request.RedemptionOption?.UtilityType ?? request.UtilityType)</td>
                                    <td>@request.PointsUsed</td>
                                    <!-- ✅ FIXED: Use RedemptionOption.DiscountAmount -->
                                    <td>R@(request.RedemptionOption?.DiscountAmount.ToString("N2") ?? request.DiscountAmount.ToString("N2"))</td>
                                    <td>@request.UtilityAccountNumber</td>
                                    <td>
                                        <div class="btn-group btn-group-sm" role="group">
                                            @using (Html.BeginForm("ApproveRedemption", "Admin", FormMethod.Post, new { style = "display:inline;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@request.RequestId" />
                                                <input type="hidden" name="notes" value="" />
                                                <button type="submit" class="btn btn-success" onclick="return confirm('Approve this redemption?')">
                                                    <i class="fas fa-check"></i> Approve
                                                </button>
                                            }
                                            @using (Html.BeginForm("RejectRedemption", "Admin", FormMethod.Post, new { style = "display:inline;" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@request.RequestId" />
                                                <div class="d-inline-flex align-items-center">
                                                    <input type="text" name="reason" placeholder="Reason..." class="form-control form-control-sm me-1" style="width:150px;" required />
                                                    <button type="submit" class="btn btn-danger" onclick="return confirm('Reject this redemption?')">
                                                        <i class="fas fa-times"></i> Reject
                                                    </button>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No pending redemption requests.
                </div>
            }
        </div>
    </div>

    <!-- Approved Requests -->
    @if (ViewBag.ApprovedRequests != null)
    {
        var approvedRequests = ViewBag.ApprovedRequests as List<BinIT2WinIT.Models.RedemptionRequest>;
        <div class="card shadow">
            <div class="card-header bg-success text-white">
                <i class="fas fa-check-circle"></i> Approved Requests (@(approvedRequests?.Count ?? 0))
            </div>
            <div class="card-body">
                @if (approvedRequests != null && approvedRequests.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Request ID</th>
                                    <th>Date</th>
                                    <th>Resident</th>
                                    <th>Utility Type</th>
                                    <th>Points Used</th>
                                    <th>Discount Amount</th>
                                    <th>Approved Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var request in approvedRequests)
                                {
                                    <tr>
                                        <td>@request.RequestId</td>
                                        <td>@request.RequestDate.ToShortDateString()</td>
                                        <!-- ✅ FIXED: Use Resident.FullName -->
                                        <td>@(request.Resident?.FullName ?? "Unknown")</td>
                                        <td>@(request.RedemptionOption?.UtilityType ?? request.UtilityType)</td>
                                        <td>@request.PointsUsed</td>
                                        <td>R@(request.RedemptionOption?.DiscountAmount.ToString("N2") ?? request.DiscountAmount.ToString("N2"))</td>
                                        <td>@(request.ApprovedDate?.ToShortDateString() ?? "N/A")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle"></i> No approved requests yet.
                    </div>
                }
            </div>
        </div>
    }

    <!-- Quick Actions -->
    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <i class="fas fa-bolt"></i> Quick Actions
                </div>
                <div class="card-body">
                    <a href="@Url.Action("ManageRedemptionOptions", "Admin")" class="btn btn-primary w-100 mb-2">
                        <i class="fas fa-cog"></i> Manage Redemption Options
                    </a>
                    <a href="@Url.Action("ExportRedemptions", "Admin")" class="btn btn-info w-100 mb-2">
                        <i class="fas fa-file-export"></i> Export Redemptions
                    </a>
                    <a href="@Url.Action("Dashboard", "Admin")" class="btn btn-secondary w-100">
                        <i class="fas fa-arrow-left"></i> Back to Dashboard
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>