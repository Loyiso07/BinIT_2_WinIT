@model List<BinIT2WinIT.Models.RedemptionRequest>

@{
    ViewBag.Title = "Manage Redemption Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-tasks text-warning"></i> Manage Redemption Requests</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#pending">Pending (@Model.Count)</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#approved">Approved (@ViewBag.ApprovedRequests?.Count ?? 0)</a>
        </li>
    </ul>

    <div class="tab-content mt-3">
        <div class="tab-pane active" id="pending">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead class="bg-dark text-white">
                            <tr>
                                <th>Date</th>
                                <th>Resident</th>
                                <th>Utility</th>
                                <th>Points</th>
                                <th>Amount</th>
                                <th>Account #</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model)
                            {
                                <tr>
                                    <td>@request.RequestDate.ToShortDateString()</td>
                                    <td>@request.Resident?.FullName</td>
                                    <td>@request.UtilityType</td>
                                    <td>@request.PointsUsed</td>
                                    <td>R@request.DiscountAmount</td>
                                    <td>@request.UtilityAccountNumber</td>
                                    <td>
                                        @using (Html.BeginForm("ApproveRedemption", "Admin", FormMethod.Post, new { style = "display:inline-block;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", request.RequestId)
                                            <input type="text" name="notes" placeholder="Notes (optional)" class="form-control form-control-sm d-inline" style="width:150px;" />
                                            <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Approve this redemption?')">
                                                <i class="fas fa-check"></i> Approve
                                            </button>
                                        }
                                        @using (Html.BeginForm("RejectRedemption", "Admin", FormMethod.Post, new { style = "display:inline-block;" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            @Html.Hidden("id", request.RequestId)
                                            <input type="text" name="reason" placeholder="Reason for rejection" class="form-control form-control-sm d-inline" style="width:150px;" required />
                                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Reject this redemption? Points will be refunded.')">
                                                <i class="fas fa-times"></i> Reject
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-success">
                    <i class="fas fa-check-circle"></i> No pending redemption requests.
                </div>
            }
        </div>

        <div class="tab-pane" id="approved">
            @if (ViewBag.ApprovedRequests != null && ((List<BinIT2WinIT.Models.RedemptionRequest>)ViewBag.ApprovedRequests).Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-bordered">
                        <thead class="bg-dark text-white">
                            <tr>
                                <th>Date</th>
                                <th>Resident</th>
                                <th>Utility</th>
                                <th>Amount</th>
                                <th>Approved By</th>
                                <th>Reference</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in ViewBag.ApprovedRequests)
                            {
                                <tr>
                                    <td>@request.ApprovedDate?.ToShortDateString()</td>
                                    <td>@request.Resident?.FullName</td>
                                    <td>@request.UtilityType</td>
                                    <td>R@request.DiscountAmount</td>
                                    <td>@request.ApprovedBy</td>
                                    <td><code>@request.ReferenceNumber</code></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No approved requests yet.
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        @Html.ActionLink("← Back to Dashboard", "Dashboard", "Admin", null, new { @class = "btn btn-secondary" })
        <a href="@Url.Action("ManageRedemptionOptions", "Admin")" class="btn btn-primary">
            <i class="fas fa-cog"></i> Manage Redemption Options
        </a>
    </div>
</div>

