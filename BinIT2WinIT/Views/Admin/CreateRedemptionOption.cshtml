@model BinIT2WinIT.Models.RedemptionOption

@{
    ViewBag.Title = "Create Redemption Option";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5><i class="fas fa-plus-circle"></i> Create Redemption Option</h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("CreateRedemptionOption", "Admin", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.UtilityType, new { @class = "form-label fw-bold" })
                            @Html.DropDownListFor(m => m.UtilityType,
                                new SelectList(new List<string> { "Water", "Electricity", "Both" }),
                                "-- Select Utility Type --",
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.UtilityType, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Description, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Description, new { @class = "form-control", placeholder = "e.g., R50 off Water Bill" })
                            @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.PointsRequired, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.PointsRequired, new { @class = "form-control", type = "number", min = "1" })
                            @Html.ValidationMessageFor(m => m.PointsRequired, "", new { @class = "text-danger" })
                            <small class="text-muted">Number of points required for this redemption.</small>
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.DiscountAmount, new { @class = "form-label fw-bold" })
                            <div class="input-group">
                                <span class="input-group-text">R</span>
                                @Html.TextBoxFor(m => m.DiscountAmount, new { @class = "form-control", type = "number", step = "0.01", min = "0.01" })
                            </div>
                            @Html.ValidationMessageFor(m => m.DiscountAmount, "", new { @class = "text-danger" })
                            <small class="text-muted">Monetary value of the discount in Rands.</small>
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.ExpiryDate, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.ExpiryDate, new { @class = "form-control", type = "date" })
                            @Html.ValidationMessageFor(m => m.ExpiryDate, "", new { @class = "text-danger" })
                            <small class="text-muted">Leave blank for no expiry.</small>
                        </div>

                        <div class="form-group mb-3">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                                @Html.LabelFor(m => m.IsActive, new { @class = "form-check-label" })
                            </div>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <i class="fas fa-save"></i> Create Option
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        @Html.ActionLink("← Back to Options", "ManageRedemptionOptions", "Admin", null, new { @class = "btn btn-secondary" })
    </div>
</div>

