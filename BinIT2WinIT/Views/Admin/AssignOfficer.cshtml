@using System.Web.Mvc
@using System.Web.Mvc.Html
@using BinIT2WinIT.Models

@model BinIT2WinIT.Models.AssignOfficerViewModel

@{
    ViewBag.Title = "Assign Region";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white">
                    <h4><i class="fas fa-map-pin"></i> Assign Region to Officer</h4>
                </div>
                <div class="card-body">
                    <!-- Success/Error Messages -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @using (Html.BeginForm("AssignOfficer", "Admin", FormMethod.Post, new { @class = "needs-validation" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.OfficerId)

                        <div class="form-group mb-3">
                            <label class="form-label fw-bold">
                                <i class="fas fa-user-tie text-primary"></i> Officer
                            </label>
                            <div class="form-control-plaintext p-2 bg-light rounded">
                                <strong>@Model.OfficerName</strong>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.DropOffPointId, "Drop-Off Point", new { @class = "form-label fw-bold" })
                            <div class="input-group">
                                <span class="input-group-text"><i class="fas fa-location-dot"></i></span>
                                @Html.DropDownListFor(
                                    m => m.DropOffPointId,
                                    Model.DropOffPoints,
                                    "-- Select Region --",
                                    new { @class = "form-control form-control-lg" }
                                )
                            </div>
                            @Html.ValidationMessageFor(m => m.DropOffPointId, "", new { @class = "text-danger mt-1" })
                            <small class="text-muted">Select the region where this officer will be assigned.</small>
                        </div>

                        <!-- Available Regions Info -->
                        if (Model.DropOffPoints != null && Model.DropOffPoints.Any())
                        {
                            <div class="alert alert-info">
                                <i class="fas fa-info-circle"></i>
                                <strong>Available Regions:</strong>
                                <div class="row mt-2">
                                    @foreach (var item in Model.DropOffPoints)
                                    {
                                        <div class="col-md-6">
                                            <span class="badge bg-primary me-1">@item.Text</span>
                                            <small class="text-muted">(ID: @item.Value)</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-warning">
                                <i class="fas fa-exclamation-triangle"></i>
                                <strong>No drop-off points found.</strong>
                                Please create a drop-off point first before assigning an officer.
                                <div class="mt-2">
                                    @Html.ActionLink("Create Drop-Off Point", "DropOffPoints", "Admin", null, new { @class = "btn btn-sm btn-success" })
                                </div>
                            </div>
                        }

                        <hr />

                        <div class="d-flex justify-content-between align-items-center mt-3">
                            @Html.ActionLink("← Back to Officers", "Officers", "Admin", null, new { @class = "btn btn-outline-secondary" })
                            <div>
                                <button type="submit" class="btn btn-primary" @(Model.DropOffPoints != null && Model.DropOffPoints.Any() ? "" : "disabled")>
                                    <i class="fas fa-save"></i> Assign Region
                                </button>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        $(document).ready(function () {
            $('.alert').delay(5000).fadeOut('slow');

            $('#DropOffPointId').on('change', function () {
                var selectedText = $(this).find('option:selected').text();
                if (selectedText !== '-- Select Region --') {
                    $(this).addClass('border-success');
                } else {
                    $(this).removeClass('border-success');
                }
            });
        });
    </script>
}