@model BinIT2WinIT.Models.Administrator

@{
    ViewBag.Title = "Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-cog text-warning"></i> Administrator Dashboard</h2>
    <p>Welcome, <strong>@Model.FullName</strong>!</p>
    <hr />

    <!-- Stats Cards -->
    <div class="row mt-4">
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-primary text-white shadow">
                <div class="card-body text-center">
                    <i class="fas fa-users fa-2x mb-2"></i>
                    <h3>@ViewBag.TotalResidents</h3>
                    <p class="mb-0">Total Residents</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-success text-white shadow">
                <div class="card-body text-center">
                    <i class="fas fa-recycle fa-2x mb-2"></i>
                    <h3>@ViewBag.TotalSubmissions</h3>
                    <p class="mb-0">Total Submissions</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-info text-white shadow">
                <div class="card-body text-center">
                    <i class="fas fa-coins fa-2x mb-2"></i>
                    <h3>@ViewBag.TotalPoints</h3>
                    <p class="mb-0">Total Points</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body text-center">
                    <i class="fas fa-clock fa-2x mb-2"></i>
                    <h3>@ViewBag.PendingSubmissions</h3>
                    <p class="mb-0">Pending Submissions</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions - Row 1: User Management -->
    <div class="row mt-4">
        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-user-shield fa-3x text-danger"></i>
                    <h5 class="mt-3">Manage Admins</h5>
                    <p class="text-muted">Add or remove administrators</p>
                    @Html.ActionLink("Manage Admins", "ManageAdmins", "Admin", null, new { @class = "btn btn-danger" })
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-user-tie fa-3x text-primary"></i>
                    <h5 class="mt-3">Manage Officers</h5>
                    <p class="text-muted">View and assign Collection Officers</p>
                    @Html.ActionLink("Go to Officers", "Officers", "Admin", null, new { @class = "btn btn-primary" })
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-users fa-3x text-info"></i>
                    <h5 class="mt-3">Manage Users</h5>
                    <p class="text-muted">Activate or deactivate users</p>
                    @Html.ActionLink("Manage Users", "Users", "Admin", null, new { @class = "btn btn-info" })
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions - Row 2: Location & Rewards -->
    <div class="row mt-4">
        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-map-pin fa-3x text-success"></i>
                    <h5 class="mt-3">Drop-Off Points</h5>
                    <p class="text-muted">Manage recycling locations</p>
                    @Html.ActionLink("Manage Locations", "DropOffPoints", "Admin", null, new { @class = "btn btn-success" })
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-coins fa-3x text-warning"></i>
                    <h5 class="mt-3">Points Rates</h5>
                    <p class="text-muted">Configure recycling rewards</p>
                    @Html.ActionLink("Manage Rates", "PointsRates", "Admin", null, new { @class = "btn btn-warning" })
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-tasks fa-3x text-warning"></i>
                    <h5 class="mt-3">Redemption Requests</h5>
                    <p class="text-muted">Manage utility discount redemptions</p>
                    @Html.ActionLink("View Requests", "ManageRedemptionRequests", "Admin", null, new { @class = "btn btn-warning" })
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions - Row 3: Communications & Reports -->
    <div class="row mt-4">
        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-bullhorn fa-3x text-warning"></i>
                    <h5 class="mt-3">Announcements</h5>
                    <p class="text-muted">Create and manage announcements</p>
                    @Html.ActionLink("Manage Announcements", "Announcements", "Admin", null, new { @class = "btn btn-warning" })
                </div>
            </div>
        </div>

        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-chart-bar fa-3x text-secondary"></i>
                    <h5 class="mt-3">Reports</h5>
                    <p class="text-muted">View community reports</p>
                    @Html.ActionLink("View Reports", "Communities", "Admin", null, new { @class = "btn btn-secondary" })
                </div>
            </div>
        </div>

        <!-- ✅ REPLACED Settings with Redemption Options -->
        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-gift fa-3x text-success"></i>
                    <h5 class="mt-3">Redemption Options</h5>
                    <p class="text-muted">Manage available redemption options</p>
                    @Html.ActionLink("Manage Options", "ManageRedemptionOptions", "Admin", null, new { @class = "btn btn-success" })
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body text-center text-muted">
                    <small>
                        <i class="fas fa-info-circle"></i>
                        BinIT2WinIT - Smart Recycling Rewards System
                        &nbsp;|&nbsp; Version 2.0
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
        transition: transform 0.2s, box-shadow 0.2s;
        border: none;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.15) !important;
        }

    .card-body {
        padding: 1.5rem;
    }

    .btn {
        border-radius: 8px;
        padding: 8px 20px;
        font-weight: 500;
        transition: all 0.2s;
    }

        .btn:hover {
            transform: scale(1.05);
        }

    .bg-primary {
        background: linear-gradient(135deg, #007bff, #0056b3) !important;
    }

    .bg-success {
        background: linear-gradient(135deg, #28a745, #1e7e34) !important;
    }

    .bg-info {
        background: linear-gradient(135deg, #17a2b8, #117a8b) !important;
    }

    .bg-warning {
        background: linear-gradient(135deg, #ffc107, #d39e00) !important;
    }

    .bg-danger {
        background: linear-gradient(135deg, #dc3545, #bd2130) !important;
    }

    .bg-secondary {
        background: linear-gradient(135deg, #6c757d, #545b62) !important;
    }

    .shadow {
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1) !important;
    }

    h3 {
        font-weight: 700;
    }

    .text-muted {
        font-size: 0.9rem;
    }

    .fa-3x {
        font-size: 2.5rem;
    }
</style>