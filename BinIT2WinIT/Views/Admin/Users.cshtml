@model IEnumerable<BinIT2WinIT.Models.ApplicationUser>

@{
    ViewBag.Title = "Manage Users";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // ✅ FIXED: No @ here (inside code block)
    var roleCounts = new Dictionary<string, int>();
    if (ViewBag.RoleCounts != null)
    {
        roleCounts = (Dictionary<string, int>)ViewBag.RoleCounts;
    }
}

<div class="container mt-4">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <div class="d-flex justify-content-between align-items-center">
        <h2><i class="fas fa-users text-primary"></i> Manage Users</h2>
        <span class="badge bg-primary">@ViewBag.TotalUsers Total Users</span>
    </div>
    <hr />

    <!-- Search & Filter Section -->
    <div class="card shadow mb-4">
        <div class="card-header bg-dark text-white">
            <i class="fas fa-search"></i> Search & Filter Users
        </div>
        <div class="card-body">
            @using (Html.BeginForm("Users", "Admin", FormMethod.Get))
            {
                <div class="row">
                    <div class="col-md-5">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input type="text" name="searchTerm" class="form-control"
                                   placeholder="Search by name or email..."
                                   value="@ViewBag.SearchTerm" />
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-filter"></i></span>
                            <select name="roleFilter" class="form-select">
                                <option value="All" @(ViewBag.SelectedRole == "All" ? "selected" : "")>
                                    All Users (@ViewBag.TotalUsers)
                                </option>
                                <option value="Administrator" @(ViewBag.SelectedRole == "Administrator" ? "selected" : "")>
                                    Administrators (@ViewBag.TotalAdmins)
                                </option>
                                <option value="CollectionOfficer" @(ViewBag.SelectedRole == "CollectionOfficer" ? "selected" : "")>
                                    Collection Officers (@ViewBag.TotalOfficers)
                                </option>
                                <option value="Resident" @(ViewBag.SelectedRole == "Resident" ? "selected" : "")>
                                    Residents (@ViewBag.TotalResidents)
                                </option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-filter"></i> Apply Filters
                        </button>
                    </div>
                </div>

                if (!string.IsNullOrEmpty(ViewBag.SearchTerm) || ViewBag.SelectedRole != "All")
                {
                    <div class="mt-2">
                        <a href="@Url.Action("Users", "Admin")" class="btn btn-sm btn-outline-secondary">
                            <i class="fas fa-times"></i> Clear Filters
                        </a>
                        <span class="text-muted ms-2">
                            <i class="fas fa-info-circle"></i>
                            Filters applied:
                            @if (!string.IsNullOrEmpty(ViewBag.SearchTerm))
                            {
                                <span class="badge bg-info">Search: "@ViewBag.SearchTerm"</span>
                            }
                            @if (ViewBag.SelectedRole != "All")
                            {
                                <span class="badge bg-info">Role: @ViewBag.SelectedRole</span>
                            }
                        </span>
                    </div>
                }
            }
        </div>
    </div>

    <!-- Role Summary Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow text-center">
                <div class="card-body">
                    <h4>@ViewBag.TotalUsers</h4>
                    <p class="mb-0">Total Users</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white shadow text-center">
                <div class="card-body">
                    <h4>@ViewBag.TotalAdmins</h4>
                    <p class="mb-0">Administrators</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow text-center">
                <div class="card-body">
                    <h4>@ViewBag.TotalOfficers</h4>
                    <p class="mb-0">Collection Officers</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow text-center">
                <div class="card-body">
                    <h4>@ViewBag.TotalResidents</h4>
                    <p class="mb-0">Residents</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card shadow">
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="bg-dark text-white">
                            <tr>
                                <th>Email</th>
                                <th>Full Name</th>
                                <th>Phone</th>
                                <th>Role</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                var role = ViewBag.UserRoles != null && ViewBag.UserRoles.ContainsKey(user.Id)
                                    ? ViewBag.UserRoles[user.Id]
                                    : "No Role";

                                <tr>
                                    <td>@user.Email</td>
                                    <td>@(user.FullName ?? "N/A")</td>
                                    <td>@(user.PhoneNumber ?? "N/A")</td>
                                    <td>
                                        <span class="badge @(role.Contains("Administrator") ? "bg-danger" : role.Contains("CollectionOfficer") ? "bg-warning text-dark" : "bg-success")">
                                            @role
                                        </span>
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactive</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            using (Html.BeginForm("DeactivateUser", "Admin", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("userId", user.Id)
                                                <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Deactivate this user?')">
                                                    <i class="fas fa-times"></i> Deactivate
                                                </button>
                                            }
                                        }
                                        else
                                        {
                                            using (Html.BeginForm("ActivateUser", "Admin", FormMethod.Post))
                                            {
                                                @Html.AntiForgeryToken()
                                                @Html.Hidden("userId", user.Id)
                                                <button type="submit" class="btn btn-success btn-sm" onclick="return confirm('Activate this user?')">
                                                    <i class="fas fa-check"></i> Activate
                                                </button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No users found matching your filters.
                </div>
            }
        </div>
    </div>

    <div class="mt-3">
        @Html.ActionLink("← Back to Dashboard", "Dashboard", "Admin", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>