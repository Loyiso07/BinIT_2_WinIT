@model List<BinIT2WinIT.Models.RedemptionOption>

@{
    ViewBag.Title = "Manage Redemption Options";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-cog text-primary"></i> Manage Redemption Options</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="mb-3">
        <a href="@Url.Action("CreateRedemptionOption", "Admin")" class="btn btn-success">
            <i class="fas fa-plus"></i> Add New Option
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="bg-dark text-white">
                    <tr>
                        <th>Utility Type</th>
                        <th>Description</th>
                        <th>Points Required</th>
                        <th>Discount Amount</th>
                        <th>Status</th>
                        <th>Expiry</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var option in Model)
                    {
                        <tr>
                            <td>@option.UtilityType</td>
                            <td>@option.Description</td>
                            <td>@option.PointsRequired</td>
                            <td>R@option.DiscountAmount</td>
                            <td>
                                <span class="badge @(option.IsActive ? "bg-success" : "bg-secondary")">
                                    @(option.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>@(option.ExpiryDate?.ToShortDateString() ?? "Never")</td>
                            <td>
                                @using (Html.BeginForm("ToggleRedemptionOption", "Admin", FormMethod.Post, new { style = "display:inline-block;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", option.OptionId)
                                    <button type="submit" class="btn btn-sm @(option.IsActive ? "btn-warning" : "btn-success")">
                                        @(option.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No redemption options configured yet.
        </div>
    }

    <div class="mt-3">
        @Html.ActionLink("← Back to Dashboard", "Dashboard", "Admin", null, new { @class = "btn btn-secondary" })
    </div>
</div>

