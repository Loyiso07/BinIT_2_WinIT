@{
    ViewBag.Title = "Community Status";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-city text-info"></i> Community Status</h2>
    <hr />

    <!-- Community Info Card -->
    <div class="card shadow mb-4">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-map-pin"></i>
            <!-- ✅ USE CommunityName instead of Community -->
            @ViewBag.CommunityName
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-3">
                    <div class="card bg-success text-white">
                        <div class="card-body text-center">
                            <h4>@ViewBag.TotalSubmissions</h4>
                            <p>Total Submissions</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-info text-white">
                        <div class="card-body text-center">
                            <h4>@ViewBag.TotalWeight.ToString("0.0") kg</h4>
                            <p>Total Weight</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-warning text-dark">
                        <div class="card-body text-center">
                            <h4>@ViewBag.PendingSubmissions</h4>
                            <p>Pending</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-secondary text-white">
                        <div class="card-body text-center">
                            <h4>@ViewBag.TotalResidents</h4>
                            <p>Residents</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Current Status -->
    <div class="card shadow mb-4">
        <div class="card-header bg-dark text-white">
            <i class="fas fa-info-circle"></i> Current Status
        </div>
        <div class="card-body">
            @if (ViewBag.CommunityStatus != null)
            {
                <div class="row">
                    <div class="col-md-6">
                        <p>
                            <strong>Status:</strong>
                            <span class="badge @(ViewBag.CommunityStatus.Status == "Active" ? "bg-success" : ViewBag.CommunityStatus.Status == "NeedsAttention" ? "bg-warning" : "bg-danger")">
                                @ViewBag.CommunityStatus.Status
                            </span>
                        </p>
                        <p><strong>Notes:</strong> @ViewBag.CommunityStatus.Notes</p>
                    </div>
                    <div class="col-md-6 text-end">
                        <p><strong>Last Updated:</strong> @ViewBag.CommunityStatus.UpdatedDate.ToString("dd MMM yyyy HH:mm")</p>
                        <p><strong>Updated By:</strong> @ViewBag.CommunityStatus.UpdatedBy</p>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    <i class="fas fa-info-circle"></i> No status has been set for this community.
                </div>
            }
        </div>
    </div>

    <!-- Update Status -->
    <div class="card shadow">
        <div class="card-header bg-success text-white">
            <i class="fas fa-edit"></i> Update Community Status
        </div>
        <div class="card-body">
            @using (Html.BeginForm("UpdateCommunityStatus", "Officer", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="dropOffPointId" value="@(ViewBag.Community?.DropOffPointId)" />

                <div class="form-group mb-3">
                    <label class="form-label fw-semibold">Status</label>
                    <select name="status" class="form-control" required>
                        <option value="Active">🟢 Active</option>
                        <option value="NeedsAttention">🟡 Needs Attention</option>
                        <option value="Critical">🔴 Critical</option>
                        <option value="Inactive">⚪ Inactive</option>
                    </select>
                </div>

                <div class="form-group mb-3">
                    <label class="form-label fw-semibold">Notes</label>
                    <textarea name="notes" class="form-control" rows="3" placeholder="Enter notes about the community..."></textarea>
                </div>

                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> Update Status
                </button>
            }
        </div>
    </div>

    <div class="mt-3">
        @Html.ActionLink("← Back to Dashboard", "Dashboard", "Officer", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>