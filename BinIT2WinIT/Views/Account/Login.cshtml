@model BinIT2WinIT.Models.LoginViewModel

@{
    ViewBag.Title = ViewBag.LoginTitle ?? "Log in";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var loginTitle = ViewBag.LoginTitle ?? "Log in";
    var loginSubtitle = ViewBag.LoginSubtitle ?? "Log in to your account";
    var role = ViewBag.Role as string ?? "General";

    // ✅ DETERMINE EXPECTED ROLE FROM THE URL (MOST RELIABLE)
    var expectedRole = "General";
    var currentUrl = Request.Url.AbsolutePath;

    if (currentUrl.Contains("OfficerLogin") || currentUrl.Contains("Officer"))
    {
        expectedRole = "CollectionOfficer";
    }
    else if (currentUrl.Contains("AdminLogin") || currentUrl.Contains("Admin"))
    {
        expectedRole = "Administrator";
    }
    else if (currentUrl.Contains("UserLogin") || currentUrl.Contains("User"))
    {
        expectedRole = "Resident";
    }
    else if (!string.IsNullOrEmpty(ViewBag.ExpectedRole as string))
    {
        expectedRole = ViewBag.ExpectedRole as string;
    }

    // Determine styling based on role
    var headerColor = role == "Administrator" ? "bg-danger" :
                     role == "CollectionOfficer" ? "bg-primary" :
                     "bg-success";

    var buttonColor = role == "Administrator" ? "btn-danger" :
                     role == "CollectionOfficer" ? "btn-primary" :
                     "btn-success";

    var icon = role == "Administrator" ? "fa-lock" :
               role == "CollectionOfficer" ? "fa-clipboard-check" :
               "fa-user";

    var showRegisterLink = role != "Administrator" && role != "CollectionOfficer";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-lg mt-5">
            <div class="card-header @headerColor text-white text-center">
                <h4>
                    <i class="fas @icon"></i>
                    @loginTitle
                </h4>
                <p class="mb-0 small">@loginSubtitle</p>
            </div>
            <div class="card-body">
                @if (role == "Administrator")
                {
                    <div class="alert alert-danger small">
                        <i class="fas fa-exclamation-triangle"></i>
                        This is a secure admin portal. Unauthorized access is prohibited.
                    </div>
                }

                <!-- ✅ Pass expectedRole - use the determined value -->
                @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl, expectedRole = expectedRole }, FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                    <!-- ✅ Hidden field with the determined value -->
                    <input type="hidden" name="expectedRole" value="@expectedRole" />
                    @Html.HiddenFor(m => m.ExpectedRole)

                    <div class="form-group mb-3">
                        @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold" })
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter your email", autofocus = "autofocus" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label fw-bold" })
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter your password" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                    </div>

                    <div class="form-group mb-3">
                        <div class="form-check">
                            @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input" })
                            @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label" })
                        </div>
                    </div>

                    <div class="form-group mb-3">
                        <button type="submit" class="btn @buttonColor w-100">
                            <i class="fas fa-sign-in-alt"></i> @loginTitle
                        </button>
                    </div>

                    <hr />

                    <div class="text-center">
                        @if (showRegisterLink)
                        {
                            <p>
                                Don't have an account?
                                @Html.ActionLink("Register here", "Register", null, new { @class = "text-success fw-bold" })
                            </p>
                        }
                        <p>
                            @Html.ActionLink("Forgot your password?", "ForgotPassword", null, new { @class = "text-muted" })
                        </p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}