@model BinIT2WinIT.Models.RegisterViewModel

@{
    ViewBag.Title = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white text-center">
                    <h4><i class="fas fa-user-plus"></i> Create Account</h4>
                    <p class="mb-0"><i class="fas fa-gift"></i> Get <strong>100 Welcome Bonus Points</strong> when you sign up!</p>
                </div>
                <div class="card-body">
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
                    }

                    @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "form-horizontal", role = "form" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <!-- ============================================================ -->
                        <!-- 1. PERSONAL DETAILS -->
                        <!-- ============================================================ -->
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.FullName, new { @class = "control-label fw-semibold" })
                                    @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Enter your full name" })
                                    @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.PhoneNumber, new { @class = "control-label fw-semibold" })
                                    @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "Enter your phone number" })
                                    @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Email, new { @class = "control-label fw-semibold" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "Enter your email address" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
                        </div>

                        <!-- ============================================================ -->
                        <!-- 2. ADDRESS SECTION -->
                        <!-- ============================================================ -->
                        <div class="card bg-light mb-3">
                            <div class="card-header">
                                <i class="fas fa-map-pin text-success"></i> Your Location
                            </div>
                            <div class="card-body">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.Address, new { @class = "control-label fw-semibold" })
                                    @Html.TextBoxFor(m => m.Address, new { @class = "form-control", placeholder = "Enter your street address" })
                                    @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            @Html.LabelFor(m => m.Suburb, new { @class = "control-label fw-semibold" })
                                            @Html.TextBoxFor(m => m.Suburb, new { @class = "form-control", placeholder = "Enter your suburb" })
                                            @Html.ValidationMessageFor(m => m.Suburb, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            @Html.LabelFor(m => m.City, new { @class = "control-label fw-semibold" })
                                            @Html.TextBoxFor(m => m.City, new { @class = "form-control", placeholder = "Enter your city" })
                                            @Html.ValidationMessageFor(m => m.City, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            @Html.LabelFor(m => m.Province, new { @class = "control-label fw-semibold" })
                                            @Html.TextBoxFor(m => m.Province, new { @class = "form-control", placeholder = "Enter your province" })
                                            @Html.ValidationMessageFor(m => m.Province, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group mb-3">
                                            @Html.LabelFor(m => m.PostalCode, new { @class = "control-label fw-semibold" })
                                            @Html.TextBoxFor(m => m.PostalCode, new { @class = "form-control", placeholder = "Enter postal code" })
                                            @Html.ValidationMessageFor(m => m.PostalCode, "", new { @class = "text-danger" })
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ============================================================ -->
                        <!-- 3. COMMUNITY SELECTION -->
                        <!-- ============================================================ -->
                        <div class="card bg-light mb-3">
                            <div class="card-header">
                                <i class="fas fa-city text-success"></i> Your Community
                            </div>
                            <div class="card-body">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.DropOffPointId, new { @class = "control-label fw-semibold" })
                                    @Html.DropDownListFor(m => m.DropOffPointId,
                                        (SelectList)ViewBag.Communities,
                                        new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.DropOffPointId, "", new { @class = "text-danger" })
                                    <small class="text-muted">Select the community where you will recycle.</small>
                                </div>
                            </div>
                        </div>

                        <!-- ============================================================ -->
                        <!-- 4. PASSWORD SECTION -->
                        <!-- ============================================================ -->
                        <div class="card bg-light mb-3">
                            <div class="card-header">
                                <i class="fas fa-lock text-warning"></i> Security
                            </div>
                            <div class="card-body">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.Password, new { @class = "control-label fw-semibold" })
                                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter password" })
                                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                                    <small class="text-muted">Password must be at least 8 characters with a mix of letters, numbers, and symbols.</small>
                                </div>

                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.ConfirmPassword, new { @class = "control-label fw-semibold" })
                                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm password" })
                                    @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <!-- ============================================================ -->
                        <!-- 5. REFERRAL SECTION -->
                        <!-- ============================================================ -->
                        <div class="card bg-light mb-3">
                            <div class="card-header">
                                <i class="fas fa-share-alt text-primary"></i> Referral
                            </div>
                            <div class="card-body">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.ReferralCode, new { @class = "control-label fw-semibold" })
                                    @Html.TextBoxFor(m => m.ReferralCode, new { @class = "form-control", placeholder = "Enter referral code (optional)" })
                                    @Html.ValidationMessageFor(m => m.ReferralCode, "", new { @class = "text-danger" })
                                    <small class="text-muted">Have a referral code? Enter it here to earn bonus points!</small>
                                </div>
                            </div>
                        </div>

                        <!-- ============================================================ -->
                        <!-- 6. SUBMIT BUTTON -->
                        <!-- ============================================================ -->
                        <div class="form-group">
                            <button type="submit" class="btn btn-success w-100">
                                <i class="fas fa-user-plus"></i> Register
                            </button>
                        </div>

                        <div class="text-center mt-3">
                            <p>
                                Already have an account? @Html.ActionLink("Login here", "Login", "Account")
                            </p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
