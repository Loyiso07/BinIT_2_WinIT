@model BinIT2WinIT.Models.Resident

@{
    ViewBag.Title = "Edit Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-primary text-white">
                    <h4><i class="fas fa-edit"></i> Edit Profile</h4>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
                    }

                    @using (Html.BeginForm("EditProfile", "Resident", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <!-- ✅ ADD THIS HIDDEN FIELD -->
                        @Html.HiddenFor(m => m.UserId)
                        @Html.HiddenFor(m => m.ResidentId)

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.FullName, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.PhoneNumber, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Address, new { @class = "form-label fw-semibold" })
                            @Html.TextBoxFor(m => m.Address, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger" })
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.Suburb, new { @class = "form-label fw-semibold" })
                                    @Html.TextBoxFor(m => m.Suburb, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.Suburb, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.City, new { @class = "form-label fw-semibold" })
                                    @Html.TextBoxFor(m => m.City, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.City, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.Province, new { @class = "form-label fw-semibold" })
                                    @Html.TextBoxFor(m => m.Province, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.Province, "", new { @class = "text-danger" })
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    @Html.LabelFor(m => m.PostalCode, new { @class = "form-label fw-semibold" })
                                    @Html.TextBoxFor(m => m.PostalCode, new { @class = "form-control" })
                                    @Html.ValidationMessageFor(m => m.PostalCode, "", new { @class = "text-danger" })
                                </div>
                            </div>
                        </div>

                        <!-- Community Selection -->
                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.DropOffPointId, new { @class = "form-label fw-semibold" })
                            @Html.DropDownListFor(m => m.DropOffPointId,
                                (SelectList)ViewBag.Communities,
                                "-- Select Your Community --",
                                new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.DropOffPointId, "", new { @class = "text-danger" })
                            <small class="text-muted">Select the community where you recycle.</small>
                        </div>

                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary">
                                <i class="fas fa-save"></i> Save Changes
                            </button>
                            @Html.ActionLink("Cancel", "ViewProfile", "Resident", null, new { @class = "btn btn-secondary ms-2" })
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}