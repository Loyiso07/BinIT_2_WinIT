@model BinIT2WinIT.Models.Resident

@{
    ViewBag.Title = "My Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <h2><i class="fas fa-user-circle text-primary"></i> My Profile</h2>
            <hr />
        </div>
    </div>

    <!-- Profile Header -->
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow text-center">
                <div class="card-body">
                    <i class="fas fa-user-circle fa-5x text-primary mb-3"></i>
                    <h4>@Model.FullName</h4>
                    <p class="text-muted"><i class="fas fa-envelope"></i> @(Model.User?.Email ?? "Not provided")</p>
                    <p class="text-muted"><i class="fas fa-phone"></i> @Model.PhoneNumber</p>
                    <p>
                        <span class="badge @(Model.IsActive ? "bg-success" : "bg-danger")">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                    </p>
                    <p><small class="text-muted">Member since: @Model.CreatedAt.ToString("dd MMM yyyy")</small></p>
                    <p>
                        <strong>Referral Code:</strong>
                        <span class="badge bg-dark"><code>@Model.ReferralCode</code></span>
                        <button class="btn btn-sm btn-outline-primary mt-1" onclick="copyReferralCode()">
                            <i class="fas fa-copy"></i>
                        </button>
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <!-- Stats Cards -->
            <div class="row">
                <div class="col-md-6">
                    <div class="card bg-success text-white shadow">
                        <div class="card-body text-center">
                            <i class="fas fa-star fa-2x mb-2"></i>
                            <h3>@Model.PointsBalance</h3>
                            <p class="mb-0">Total Points</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-info text-white shadow">
                        <div class="card-body text-center">
                            <i class="fas fa-trophy fa-2x mb-2"></i>
                            <h3>#@ViewBag.Rank</h3>
                            <p class="mb-0">Leaderboard Rank</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row mt-3">
                <div class="col-md-6">
                    <div class="card bg-warning text-dark shadow">
                        <div class="card-body text-center">
                            <i class="fas fa-users fa-2x mb-2"></i>
                            <h3>@Model.InfluencerPoints</h3>
                            <p class="mb-0">Influencer Points</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-secondary text-white shadow">
                        <div class="card-body text-center">
                            <i class="fas fa-leaf fa-2x mb-2"></i>
                            <h3>@Model.TotalCO2Saved.ToString("0.0") kg</h3>
                            <p class="mb-0">CO2 Saved</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Address & Community -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <i class="fas fa-map-pin"></i> Address Information
                </div>
                <div class="card-body">
                    <p><strong>Address:</strong> @(Model.Address ?? "Not provided")</p>
                    <p><strong>Suburb:</strong> @(Model.Suburb ?? "Not provided")</p>
                    <p><strong>City:</strong> @(Model.City ?? "Not provided")</p>
                    <p><strong>Province:</strong> @(Model.Province ?? "Not provided")</p>
                    <p><strong>Postal Code:</strong> @(Model.PostalCode ?? "Not provided")</p>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <i class="fas fa-city"></i> Community
                </div>
                <div class="card-body">
                    @if (Model.Community != null)
                    {
                        <p><strong>Community:</strong> <span class="badge bg-success">@Model.Community.Name</span></p>
                        <p><strong>Address:</strong> @Model.Community.Address</p>
                        <p><strong>City:</strong> @Model.Community.City</p>
                        <p><strong>Contact:</strong> @Model.Community.ContactPerson</p>
                        <p><strong>Phone:</strong> @Model.Community.PhoneNumber</p>
                    }
                    else
                    {
                        <p class="text-muted">No community assigned yet.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recycling Stats -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <i class="fas fa-recycle"></i> Recycling Statistics
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-md-3">
                            <h4>@ViewBag.TotalSubmissions</h4>
                            <p class="text-muted">Total</p>
                        </div>
                        <div class="col-md-3">
                            <h4 class="text-success">@ViewBag.VerifiedSubmissions</h4>
                            <p class="text-muted">Verified</p>
                        </div>
                        <div class="col-md-3">
                            <h4 class="text-warning">@ViewBag.PendingSubmissions</h4>
                            <p class="text-muted">Pending</p>
                        </div>
                        <div class="col-md-3">
                            <h4 class="text-danger">@ViewBag.RejectedSubmissions</h4>
                            <p class="text-muted">Rejected</p>
                        </div>
                    </div>
                    <hr />
                    <div class="text-center">
                        <h4>Total Weight Recycled: <strong>@ViewBag.TotalWeight.ToString("0.0") kg</strong></h4>
                        @{
                            var progress = ViewBag.TotalWeight > 0 ? Math.Min((ViewBag.TotalWeight / 100) * 100, 100) : 0;
                        }
                        <div class="progress" style="height: 25px;">
                            <div class="progress-bar progress-bar-striped bg-success" style="width: @progress%">
                                @((int)progress)% to 100kg goal
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Referral Section -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <i class="fas fa-share-alt"></i> Referral Information
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Your Referral Code:</strong></p>
                            <h3><code>@Model.ReferralCode</code></h3>
                            <button class="btn btn-sm btn-primary mt-2" onclick="copyReferralCode()">
                                <i class="fas fa-copy"></i> Copy Code
                            </button>
                        </div>
                        <div class="col-md-6">
                            <p><strong>Total Referrals:</strong> @Model.TotalReferrals</p>
                            <p><strong>Influencer Points:</strong> @Model.InfluencerPoints</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <i class="fas fa-bolt"></i> Quick Actions
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2">
                        @Html.ActionLink("Submit Recycling", "SubmitRecycling", "Resident", null, new { @class = "btn btn-success" })
                        @Html.ActionLink("View Leaderboard", "Leaderboard", "Resident", null, new { @class = "btn btn-warning" })
                        @Html.ActionLink("Points History", "PointsHistory", "Resident", null, new { @class = "btn btn-info" })
                        @Html.ActionLink("Edit Profile", "EditProfile", "Resident", null, new { @class = "btn btn-primary" })
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Back to Dashboard -->
    <div class="mt-3">
        @Html.ActionLink("← Back to Dashboard", "Dashboard", "Resident", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>

<script>
    function copyReferralCode() {
        var code = '@Model.ReferralCode';
        if (navigator.clipboard) {
            navigator.clipboard.writeText(code).then(function() {
                showToast('Referral code copied: ' + code);
            }).catch(function() {
                fallbackCopy(code);
            });
        } else {
            fallbackCopy(code);
        }
    }

    function fallbackCopy(text) {
        var input = document.createElement('input');
        input.value = text;
        document.body.appendChild(input);
        input.select();
        document.execCommand('copy');
        document.body.removeChild(input);
        showToast('Referral code copied: ' + text);
    }

    function showToast(message) {
        var toast = document.createElement('div');
        toast.className = 'alert alert-success alert-dismissible fade show position-fixed top-0 end-0 m-3';
        toast.style.zIndex = '9999';
        toast.innerHTML = '<i class="fas fa-check-circle"></i> ' + message +
            '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>';
        document.body.appendChild(toast);
        setTimeout(function() {
            toast.remove();
        }, 3000);
    }
</script>