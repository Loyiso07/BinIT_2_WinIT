@model BinIT2WinIT.Models.Resident

@{
    ViewBag.Title = "Resident Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <!-- Success/Error Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-12">
            <h2><i class="fas fa-home text-success"></i> Welcome, @Model.FullName!</h2>
            <hr />
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row mt-4">
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-success text-white shadow">
                <div class="card-body text-center">
                    <i class="fas fa-star fa-2x mb-2"></i>
                    <h3>@Model.PointsBalance</h3>
                    <p class="mb-0">Total Points</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-info text-white shadow">
                <div class="card-body text-center">
                    <i class="fas fa-users fa-2x mb-2"></i>
                    <h3>@Model.InfluencerPoints</h3>
                    <p class="mb-0">Influencer Points</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body text-center">
                    <i class="fas fa-leaf fa-2x mb-2"></i>
                    <h3>@Model.TotalCO2Saved.ToString("0.0") kg</h3>
                    <p class="mb-0">CO2 Saved</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-danger text-white shadow">
                <div class="card-body text-center">
                    <i class="fas fa-gift fa-2x mb-2"></i>
                    <h3>@ViewBag.PendingRedemptions</h3>
                    <p class="mb-0">Pending Redemptions</p>
                </div>
            </div>
        </div>
    </div>

    <!-- ✅ NOTIFICATIONS SECTION -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
                    <div>
                        <i class="fas fa-bell"></i> Notifications
                        @if (ViewBag.UnreadCount > 0)
                        {
                            <span class="badge bg-danger ms-2">@ViewBag.UnreadCount unread</span>
                        }
                    </div>
                    @if (ViewBag.UnreadCount > 0)
                    {
                        <button onclick="markAllRead()" class="btn btn-sm btn-light">
                            <i class="fas fa-check-double"></i> Mark All Read
                        </button>
                    }
                </div>
                <div class="card-body">
                    @if (ViewBag.Notifications != null && ((List<BinIT2WinIT.Models.Notification>)ViewBag.Notifications).Any())
                    {
                        foreach (var notif in (List<BinIT2WinIT.Models.Notification>)ViewBag.Notifications)
                        {
                            <div class="alert @(notif.IsRead ? "alert-secondary" : "alert-info")">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>@notif.Title</strong>
                                        <p class="mb-0">@notif.Message</p>
                                        <small class="text-muted">@notif.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                                    </div>
                                    <div>
                                        @if (!notif.IsRead)
                                        {
                                            <button onclick="markAsRead(@notif.NotificationId)" class="btn btn-sm btn-outline-primary">
                                                <i class="fas fa-check"></i> Mark Read
                                            </button>
                                        }
                                        @if (!string.IsNullOrEmpty(notif.Link))
                                        {
                                            <a href="@notif.Link" class="btn btn-sm btn-outline-info">
                                                <i class="fas fa-arrow-right"></i> View
                                            </a>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="text-center mt-2">
                            <a href="@Url.Action("Notifications", "Resident")" class="btn btn-sm btn-outline-secondary">
                                View All Notifications
                            </a>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted text-center mb-0">
                            <i class="fas fa-check-circle text-success"></i> No new notifications
                        </p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions - Row 1: Main Actions -->
    <div class="row mt-4">
        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-recycle fa-3x text-success"></i>
                    <h5 class="mt-3">Submit Recycling</h5>
                    <p class="text-muted">Log your recycling activity and earn points</p>
                    @Html.ActionLink("Submit Now", "SubmitRecycling", "Resident", null, new { @class = "btn btn-success" })
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-gift fa-3x text-warning"></i>
                    <h5 class="mt-3">Redeem Points</h5>
                    <p class="text-muted">Convert your points to utility discounts</p>
                    @Html.ActionLink("Redeem Now", "RedeemPoints", "Resident", null, new { @class = "btn btn-warning" })
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-history fa-3x text-primary"></i>
                    <h5 class="mt-3">Points History</h5>
                    <p class="text-muted">View all your points transactions</p>
                    @Html.ActionLink("View History", "PointsHistory", "Resident", null, new { @class = "btn btn-primary" })
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions - Row 2: Social & Community -->
    <div class="row mt-4">
        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-share-alt fa-3x text-warning"></i>
                    <h5 class="mt-3">Referral Code</h5>
                    <p class="text-muted">Share to earn influencer points!</p>
                    <div class="bg-light p-2 rounded mb-2">
                        <strong><code>@Model.ReferralCode</code></strong>
                    </div>
                    @Html.ActionLink("View Details", "InfluencerPoints", "Resident", null, new { @class = "btn btn-warning" })
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-trophy fa-3x text-warning"></i>
                    <h5 class="mt-3">Leaderboard</h5>
                    <p class="text-muted">See how you compare to other recyclers</p>
                    @Html.ActionLink("View Leaderboard", "Leaderboard", "Resident", null, new { @class = "btn btn-warning" })
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card h-100 shadow">
                <div class="card-body text-center">
                    <i class="fas fa-user-edit fa-3x text-info"></i>
                    <h5 class="mt-3">Edit Profile</h5>
                    <p class="text-muted">Update your personal information</p>
                    @Html.ActionLink("Edit Profile", "EditProfile", "Resident", null, new { @class = "btn btn-info" })
                </div>
            </div>
        </div>
    </div>

    <!-- Announcements / Rewards Section -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-warning text-dark">
                    <i class="fas fa-bullhorn"></i> Announcements & Rewards
                </div>
                <div class="card-body">
                    @if (ViewBag.Announcements != null && ((List<BinIT2WinIT.Models.Announcement>)ViewBag.Announcements).Any())
                    {
                        foreach (var announcement in (List<BinIT2WinIT.Models.Announcement>)ViewBag.Announcements)
                        {
                            <div class="alert @(announcement.RewardType == "Voucher" ? "alert-success" : announcement.RewardType == "CommunityReward" ? "alert-info" : "alert-secondary")">
                                <h5><i class="fas fa-star"></i> @announcement.Title</h5>
                                <p>@announcement.Message</p>
                                @if (announcement.MinPointsRequired.HasValue)
                                {
                                    <p>
                                        <strong>Required Points:</strong> @announcement.MinPointsRequired pts
                                        @if (Model.PointsBalance >= announcement.MinPointsRequired.Value)
                                        {
                                            <span class="badge bg-success"><i class="fas fa-check"></i> You qualify!</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@(announcement.MinPointsRequired.Value - Model.PointsBalance) more points needed</span>
                                        }
                                    </p>
                                }
                                @if (!string.IsNullOrEmpty(announcement.VoucherCode))
                                {
                                    <p><strong>Voucher Code:</strong> <code>@announcement.VoucherCode</code></p>
                                }
                                @if (!string.IsNullOrEmpty(announcement.CommunityReward))
                                {
                                    <p class="text-success"><i class="fas fa-city"></i> <strong>Community Reward:</strong> 🎉 @announcement.CommunityReward</p>
                                }
                                <small class="text-muted">Posted: @announcement.CreatedAt.ToShortDateString()</small>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted">No announcements at this time. Check back later for rewards and updates!</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Activity Section -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-header bg-secondary text-white">
                    <i class="fas fa-clock"></i> Recent Activity
                </div>
                <div class="card-body">
                    @if (Model.Submissions != null && Model.Submissions.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Material</th>
                                        <th>Weight (kg)</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var submission in Model.Submissions.OrderByDescending(s => s.SubmissionDate).Take(5))
                                    {
                                        <tr>
                                            <td>@submission.SubmissionDate.ToShortDateString()</td>
                                            <td>@(submission.MaterialType?.Name ?? "Unknown")</td>
                                            <td>@submission.Weight.ToString("0.0")</td>
                                            <td>
                                                <span class="badge @(submission.Status == "Confirmed" ? "bg-success" : submission.Status == "Pending" ? "bg-warning" : "bg-danger")">
                                                    @submission.Status
                                                </span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">No recent recycling activity. Start recycling today!</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Redemption Stats -->
    <div class="row mt-4">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <i class="fas fa-check-circle"></i> Redemption Stats
                </div>
                <div class="card-body">
                    <div class="row text-center">
                        <div class="col-6">
                            <h4>@ViewBag.ApprovedRedemptions</h4>
                            <p class="text-muted">Approved</p>
                        </div>
                        <div class="col-6">
                            <h4>@ViewBag.PendingRedemptions</h4>
                            <p class="text-muted">Pending</p>
                        </div>
                    </div>
                    <div class="text-center mt-2">
                        @Html.ActionLink("View Redemption History", "RedemptionHistory", "Resident", null, new { @class = "btn btn-outline-success btn-sm" })
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header bg-dark text-white">
                    <i class="fas fa-bolt"></i> Quick Tips
                </div>
                <div class="card-body">
                    <ul class="list-unstyled">
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success"></i>
                            Recycle regularly to earn more points
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success"></i>
                            Share your referral code to earn influencer points
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success"></i>
                            Check announcements for special rewards
                        </li>
                        <li class="mb-2">
                            <i class="fas fa-check-circle text-success"></i>
                            Redeem points for utility discounts
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <div class="row mt-4">
        <div class="col-12">
            <div class="card shadow">
                <div class="card-body text-center text-muted">
                    <small>
                        <i class="fas fa-info-circle"></i>
                        BinIT2WinIT - Smart Recycling Rewards System
                        &nbsp;|&nbsp; Version 2.0
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function markAsRead(id) {
        $.post('@Url.Action("MarkNotificationRead", "Resident")', { id: id })
            .done(function (response) {
                if (response.success) {
                    location.reload();
                }
            });
    }

    function markAllRead() {
        $.post('@Url.Action("MarkAllRead", "Resident")')
            .done(function (response) {
                if (response.success) {
                    location.reload();
                }
            });
    }
</script>