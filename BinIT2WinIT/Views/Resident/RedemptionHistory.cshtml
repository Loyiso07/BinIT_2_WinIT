@model BinIT2WinIT.Models.RedemptionHistoryViewModel

@{
    ViewBag.Title = "Redemption History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-history text-info"></i> Redemption History</h2>
    <hr />

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow">
                <div class="card-body text-center">
                    <h3>@(Model?.Requests?.Count ?? 0)</h3>
                    <p>Total Requests</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body text-center">
                    <h3>@(Model?.TotalPointsRedeemed ?? 0)</h3>
                    <p>Points Redeemed</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow">
                <div class="card-body text-center">
                    <h3>R@((Model?.TotalDiscountsReceived ?? 0m).ToString("0.00"))</h3>
                    <p>Total Discounts</p>
                </div>
            </div>
        </div>
    </div>

    @if (Model?.Requests != null && Model.Requests.Any())
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="bg-dark text-white">
                    <tr>
                        <th>Date</th>
                        <th>Reference</th>
                        <th>Utility Type</th>
                        <th>Points Used</th>
                        <th>Discount</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.Requests)
                    {
                        <tr>
                            <td>@request.RequestDate.ToShortDateString()</td>
                            <td><code>@request.ReferenceNumber</code></td>
                            <td>@request.UtilityType</td>
                            <td>@request.PointsUsed</td>
                            <td>R@(request.DiscountAmount.ToString("0.00"))</td>
                            <td>
                                <span class="badge @(request.RequestStatus == "Pending" ? "bg-warning" :
                                                    request.RequestStatus == "Approved" ? "bg-success" :
                                                    request.RequestStatus == "Applied" ? "bg-primary" :
                                                    "bg-danger")">
                                    @request.RequestStatus
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No redemption history found.
        </div>
    }

    <div class="mt-3">
        @Html.ActionLink("← Back to Dashboard", "Dashboard", "Resident", null, new { @class = "btn btn-secondary" })
    </div>
</div>

<style>
    .card {
        border-radius: 10px;
        transition: transform 0.2s;
    }

        .card:hover {
            transform: translateY(-5px);
        }

    .badge {
        font-size: 0.9em;
        padding: 5px 12px;
    }

    .table th {
        vertical-align: middle;
    }

    code {
        background-color: #f4f4f4;
        padding: 2px 6px;
        border-radius: 3px;
        font-size: 0.9em;
    }
</style>