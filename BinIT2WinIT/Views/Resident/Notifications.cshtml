@model List<BinIT2WinIT.Models.Notification>

@{
    ViewBag.Title = "Notifications";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h2><i class="fas fa-bell text-warning"></i> Notifications</h2>
        @if (Model.Any(n => !n.IsRead))
        {
            <button onclick="markAllRead()" class="btn btn-sm btn-primary">
                <i class="fas fa-check-double"></i> Mark All Read
            </button>
        }
    </div>
    <hr />

    @if (Model != null && Model.Any())
    {
        <div class="list-group">
            @foreach (var notification in Model)
            {
                <a href="@(notification.Link ?? "#")"
                   class="list-group-item list-group-item-action @(!notification.IsRead ? "bg-light border-start border-primary border-4" : "")">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">@notification.Title</h5>
                        <small class="text-muted">@notification.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                    </div>
                    <p class="mb-1">@notification.Message</p>
                    @if (!notification.IsRead)
                    {
                        <small class="text-primary">New</small>
                    }
                </a>
            }
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-check-circle"></i> No notifications
        </div>
    }

    <div class="mt-3">
        @Html.ActionLink("← Back to Dashboard", "Dashboard", "Resident", null, new { @class = "btn btn-outline-secondary" })
    </div>
</div>

<script>
    function markAllRead() {
        $.post('@Url.Action("MarkAllRead", "Resident")')
            .done(function() {
                location.reload();
            });
    }
</script>
