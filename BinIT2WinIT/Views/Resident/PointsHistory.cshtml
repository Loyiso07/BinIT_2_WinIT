@using BinIT2WinIT.Models
@model BinIT2WinIT.Models.Resident

@{
    ViewBag.Title = "Points History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .transaction-positive {
        color: #28a745;
        font-weight: 600;
    }

    .transaction-negative {
        color: #dc3545;
        font-weight: 600;
    }

    .balance-highlight {
        font-weight: 700;
        color: #1a472a;
    }
</style>

<div class="container mt-4">
    <h2><i class="fas fa-history text-primary"></i> Points History</h2>
    <hr />

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card bg-success text-white shadow">
                <div class="card-body text-center">
                    <i class="fas fa-coins fa-2x mb-2"></i>
                    <h3>@Model.PointsBalance</h3>
                    <p class="mb-0">Current Balance</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card bg-info text-white shadow">
                <div class="card-body text-center">
                    <i class="fas fa-arrow-up fa-2x mb-2"></i>
                    <h3>
                        @{
                            // ✅ FIXED: Use var instead of explicit type
                            var transactionList = Model.PointsTransactions?.ToList() ?? new List<PointsTransaction>();
                            var totalEarned = transactionList.Where(t => t.Amount > 0).Sum(t => t.Amount);
                        }
                        @totalEarned
                    </h3>
                    <p class="mb-0">Total Earned</p>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6 mb-3">
            <div class="card bg-secondary text-white shadow">
                <div class="card-body text-center">
                    <i class="fas fa-list fa-2x mb-2"></i>
                    <h3>
                        @{
                            // ✅ FIXED: Use var instead of explicit type
                            var count = Model.PointsTransactions?.Count() ?? 0;
                        }
                        @count
                    </h3>
                    <p class="mb-0">Total Transactions</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Filters -->
    <div class="row mb-3">
        <div class="col-md-6">
            <div class="btn-group" role="group">
                <button class="btn btn-outline-secondary filter-btn active" data-filter="all">All</button>
                <button class="btn btn-outline-success filter-btn" data-filter="positive">Earned</button>
                <button class="btn btn-outline-danger filter-btn" data-filter="negative">Redeemed</button>
            </div>
        </div>
        <div class="col-md-6 text-end">
            <input type="text" id="searchInput" class="form-control d-inline-block w-auto" placeholder="Search transactions..." />
        </div>
    </div>

    <!-- Transactions Table -->
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <i class="fas fa-list"></i> Transaction History
        </div>
        <div class="card-body">
            @{
                // ✅ FIXED: Use var instead of explicit type
                var transactions = Model.PointsTransactions?.ToList() ?? new List<PointsTransaction>();
            }
            @if (transactions.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover" id="transactionTable">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Description</th>
                                <th>Type</th>
                                <th>Amount</th>
                                <th>Balance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                // ✅ Use decimal for running balance
                                decimal runningBalance = 0;
                            }
                            @foreach (var transaction in transactions.OrderBy(t => t.TransactionDate))
                            {
                                runningBalance += transaction.Amount;
                                <tr class="transaction-row @(transaction.Amount > 0 ? "positive" : "negative")">
                                    <td>@transaction.TransactionDate.ToString("dd MMM yyyy")</td>
                                    <td>@transaction.Description</td>
                                    <td>
                                        <span class="badge @(transaction.Amount > 0 ? "bg-success" : transaction.Amount < 0 ? "bg-danger" : "bg-secondary")">
                                            @transaction.Type
                                        </span>
                                    </td>
                                    <td class="@(transaction.Amount > 0 ? "transaction-positive" : "transaction-negative")">
                                        @(transaction.Amount > 0 ? "+" : "")@transaction.Amount
                                    </td>
                                    <td class="balance-highlight">@runningBalance</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle"></i> No transactions found. Start recycling to earn points!
                </div>
            }
        </div>
    </div>

    <!-- Back Button -->
    <div class="mt-3 d-flex gap-2 flex-wrap">
        <a href="@Url.Action("Dashboard", "Resident")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
        <a href="@Url.Action("SubmitRecycling", "Resident")" class="btn btn-success">
            <i class="fas fa-recycle"></i> Submit Recycling
        </a>
        <a href="@Url.Action("RedeemPoints", "Resident")" class="btn btn-warning">
            <i class="fas fa-gift"></i> Redeem Points
        </a>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Filter functionality
            $('.filter-btn').on('click', function () {
                $('.filter-btn').removeClass('active');
                $(this).addClass('active');

                var filter = $(this).data('filter');
                $('.transaction-row').show();

                if (filter === 'positive') {
                    $('.transaction-row.negative').hide();
                } else if (filter === 'negative') {
                    $('.transaction-row.positive').hide();
                }
            });

            // Search functionality
            $('#searchInput').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $('.transaction-row').filter(function () {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1);
                });
            });
        });
    </script>
}