@model BinIT2WinIT.Models.RedeemPointsViewModel

@{
    ViewBag.Title = "Redeem Points";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-gift text-success"></i> Redeem Points</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-4">
            <div class="card bg-success text-white shadow">
                <div class="card-body text-center">
                    <h3>@Model.PointsBalance</h3>
                    <p class="mb-0">Available Points</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white shadow">
                <div class="card-body text-center">
                    <h3>@Model.AvailableOptions?.Count ?? 0</h3>
                    <p class="mb-0">Available Offers</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body text-center">
                    <a href="@Url.Action("RedeemHistory", "Resident")" class="text-dark">
                        <h3><i class="fas fa-history"></i></h3>
                        <p class="mb-0">View History</p>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h5><i class="fas fa-exchange-alt"></i> Select Redemption Option</h5>
                </div>
                <div class="card-body">
                    @if (Model.AvailableOptions != null && Model.AvailableOptions.Any())
                    {
                        using (Html.BeginForm("RedeemPoints", "Resident", FormMethod.Post, new { role = "form" }))
                        {
                            @Html.AntiForgeryToken()
                            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                            <div class="form-group mb-3">
                                @Html.LabelFor(m => m.SelectedOptionId, "Select Offer", new { @class = "form-label fw-bold" })
                                @Html.DropDownListFor(m => m.SelectedOptionId,
                                    new SelectList(Model.AvailableOptions, "OptionId", "Description"),
                                    "-- Select an offer --",
                                    new { @class = "form-control" })
                                @Html.ValidationMessageFor(m => m.SelectedOptionId, "", new { @class = "text-danger" })
                            </div>

                            <div class="form-group mb-3">
                                @Html.LabelFor(m => m.UtilityAccountNumber, "Municipal Utility Account Number", new { @class = "form-label fw-bold" })
                                @Html.TextBoxFor(m => m.UtilityAccountNumber, new { @class = "form-control", placeholder = "Enter your utility account number" })
                                @Html.ValidationMessageFor(m => m.UtilityAccountNumber, "", new { @class = "text-danger" })
                                <small class="text-muted">This is the account number on your municipal bill.</small>
                            </div>

                            <div id="selectedOfferDetails" class="alert alert-info" style="display:none;">
                                <h6>Selected Offer Details:</h6>
                                <p id="offerDetails"></p>
                            </div>

                            <button type="submit" class="btn btn-success w-100">
                                <i class="fas fa-check-circle"></i> Redeem Points
                            </button>
                        }
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> No redemption options available at the moment. Please check back later.
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow">
                <div class="card-header bg-info text-white">
                    <h6><i class="fas fa-info-circle"></i> How It Works</h6>
                </div>
                <div class="card-body small">
                    <p><i class="fas fa-check-circle text-success"></i> Choose a redemption option above.</p>
                    <p><i class="fas fa-check-circle text-success"></i> Enter your municipal account number.</p>
                    <p><i class="fas fa-check-circle text-success"></i> Points will be deducted immediately.</p>
                    <p><i class="fas fa-check-circle text-success"></i> Your request will be sent to the municipality.</p>
                    <p><i class="fas fa-check-circle text-success"></i> Discount will be applied to your next bill.</p>
                    <hr />
                    <p class="text-muted"><strong>Note:</strong> Redemption is subject to approval by the municipality.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            $('#SelectedOptionId').on('change', function () {
                var selectedId = $(this).val();
                if (selectedId) {
                    var options = @Html.Raw(Json.Encode(Model.AvailableOptions));
                    var selected = options.find(o => o.OptionId == selectedId);
                    if (selected) {
                        $('#offerDetails').text(
                            selected.UtilityType + ' - ' +
                            'R' + selected.DiscountAmount + ' off for ' +
                            selected.PointsRequired + ' points'
                        );
                        $('#selectedOfferDetails').show();
                    }
                } else {
                    $('#selectedOfferDetails').hide();
                }
            });
        });
    </script>
}
