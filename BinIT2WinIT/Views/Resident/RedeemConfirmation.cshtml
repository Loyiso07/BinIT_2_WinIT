@model BinIT2WinIT.Models.RedemptionRequest

@{
    ViewBag.Title = "Redemption Confirmation";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-success text-white text-center">
                    <h4><i class="fas fa-check-circle"></i> Redemption Confirmed!</h4>
                </div>
                <div class="card-body text-center">
                    <i class="fas fa-check-circle text-success fa-5x mb-3"></i>
                    <h4>Your request has been submitted successfully!</h4>

                    <div class="alert alert-info mt-4">
                        <strong>Reference Number:</strong>
                        <h3><code>@Model.ReferenceNumber</code></h3>
                    </div>

                    <div class="row mt-4">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <h6>Utility Type</h6>
                                    <p><strong>@Model.UtilityType</strong></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <h6>Discount Amount</h6>
                                    <p><strong>R@Model.DiscountAmount</strong></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <h6>Points Used</h6>
                                    <p><strong>@Model.PointsUsed</strong></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-body">
                                    <h6>Account Number</h6>
                                    <p><strong>@Model.UtilityAccountNumber</strong></p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-warning mt-4">
                        <i class="fas fa-clock"></i>
                        <strong>Status:</strong> @Model.RequestStatus
                        <br />
                        <small>Your request will be processed by the municipality. Discount will appear on your next utility bill.</small>
                    </div>

                    <div class="mt-3">
                        @Html.ActionLink("← Back to Dashboard", "Dashboard", "Resident", null, new { @class = "btn btn-secondary" })
                        @Html.ActionLink("View History", "RedeemHistory", "Resident", null, new { @class = "btn btn-outline-success" })
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

