@model IEnumerable<BinIT2WinIT.Models.RedemptionRequest>

@{
    ViewBag.Title = "Redemption History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-history text-info"></i> Redemption History</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats Cards -->
    <div class="row mb-4">
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-primary text-white shadow">
                <div class="card-body text-center">
                    <i class="fas fa-list fa-2x mb-2"></i>
                    <h3>@Model.Count()</h3>
                    <p class="mb-0">Total Requests</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body text-center">
                    <i class="fas fa-coins fa-2x mb-2"></i>
                    <h3>@Model.Sum(r => r.PointsUsed)</h3>
                    <p class="mb-0">Points Redeemed</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-success text-white shadow">
                <div class="card-body text-center">
                    <i class="fas fa-check-circle fa-2x mb-2"></i>
                    <h3>@Model.Count(r => r.RequestStatus == "Approved")</h3>
                    <p class="mb-0">Approved</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-danger text-white shadow">
                <div class="card-body text-center">
                    <i class="fas fa-times-circle fa-2x mb-2"></i>
                    <h3>@Model.Count(r => r.RequestStatus == "Rejected")</h3>
                    <p class="mb-0">Rejected</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Redemption History Table -->
    <div class="card shadow">
        <div class="card-header bg-dark text-white">
            <i class="fas fa-list"></i> Your Redemptions
        </div>
        <div class="card-body">
            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Utility Type</th>
                                <th>Description</th>
                                <th>Points Used</th>
                                <th>Discount</th>
                                <th>Account Number</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var request in Model.OrderByDescending(r => r.RequestDate))
                            {
                                <tr>
                                    <td>@request.RequestDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="badge bg-info">
                                            @(request.RedemptionOption?.UtilityType ?? request.UtilityType)
                                        </span>
                                    </td>
                                    <td>@(request.RedemptionOption?.Description ?? "N/A")</td>
                                    <td><strong>@request.PointsUsed</strong></td>
                                    <td class="text-success">
                                        <strong>
                                            @{
                                                var discountAmount = request.RedemptionOption?.DiscountAmount ?? request.DiscountAmount;
                                                @:R@(discountAmount.ToString("N2"))
                                            }
                                        </strong>
                                    </td>
                                    <td>@request.UtilityAccountNumber</td>
                                    <td>
                                        @if (request.RequestStatus == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">Pending</span>
                                        }
                                        else if (request.RequestStatus == "Approved")
                                        {
                                            <span class="badge bg-success">Approved</span>
                                        }
                                        else if (request.RequestStatus == "Applied")
                                        {
                                            <span class="badge bg-primary">Applied</span>
                                        }
                                        else if (request.RequestStatus == "Rejected")
                                        {
                                            <span class="badge bg-danger">Rejected</span>
                                            if (!string.IsNullOrEmpty(request.AdminNotes))
                                            {
                                                <br />
                                                <small class="text-muted">Reason: @request.AdminNotes</small>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info text-center">
                    <i class="fas fa-info-circle"></i> You haven't made any redemption requests yet.
                    <br />
                    <a href="@Url.Action("RedeemPoints", "Resident")" class="btn btn-success mt-2">
                        <i class="fas fa-gift"></i> Redeem Points Now
                    </a>
                </div>
            }
        </div>
    </div>

    <!-- Back Button -->
    <div class="mt-3 d-flex gap-2 flex-wrap">
        <a href="@Url.Action("Dashboard", "Resident")" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Back to Dashboard
        </a>
        <a href="@Url.Action("RedeemPoints", "Resident")" class="btn btn-success">
            <i class="fas fa-gift"></i> Redeem More Points
        </a>
        <a href="@Url.Action("PointsHistory", "Resident")" class="btn btn-info">
            <i class="fas fa-coins"></i> Points History
        </a>
        <a href="@Url.Action("SubmitRecycling", "Resident")" class="btn btn-primary">
            <i class="fas fa-recycle"></i> Submit Recycling
        </a>
    </div>
</div>