@model List<BinIT2WinIT.Models.SmartBin>

@{
    ViewBag.Title = "IoT Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-wifi text-primary"></i> IoT Smart Bin Dashboard</h2>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Admin Controls -->
    @if (User.IsInRole("Administrator"))
    {
        <div class="mb-3">
            <a href="@Url.Action("RegisterBin", "IoT")" class="btn btn-success">
                <i class="fas fa-plus-circle"></i> Register New Bin
            </a>
            <a href="@Url.Action("ManageAlerts", "IoT")" class="btn btn-warning">
                <i class="fas fa-bell"></i> Manage Alerts
            </a>
            <button onclick="simulateData()" class="btn btn-primary">
                <i class="fas fa-sync-alt"></i> Simulate Live Data
            </button>
        </div>
    }

    <!-- Stats -->
    <div class="row mt-3">
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-primary text-white shadow">
                <div class="card-body text-center">
                    <h3>@ViewBag.TotalBins</h3>
                    <p>Total Bins</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-danger text-white shadow">
                <div class="card-body text-center">
                    <h3>@ViewBag.FullBins</h3>
                    <p>Full Bins (90%+)</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body text-center">
                    <h3>@ViewBag.MaintenanceBins</h3>
                    <p>Maintenance Needed</p>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6 mb-3">
            <div class="card bg-danger text-white shadow">
                <div class="card-body text-center">
                    <h3>@ViewBag.ActiveAlerts</h3>
                    <p>Active Alerts</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts Section -->
    @if (ViewBag.Alerts != null && ((List<BinIT2WinIT.Models.BinAlert>)ViewBag.Alerts).Any())
    {
        <div class="alert alert-danger">
            <h5><i class="fas fa-exclamation-triangle"></i> Active Alerts</h5>
            <ul>
                @foreach (var alert in ViewBag.Alerts)
                {
                    <li>
                        @alert.Message
                        <em class="text-muted">(@alert.CreatedAt.ToString("HH:mm"))</em>
                        <span class="badge bg-@(alert.AlertType == "Full" ? "warning" : "danger")">
                            @alert.AlertType
                        </span>
                        @if (alert.AssignedOfficer != null)
                        {
                            <span class="badge bg-info">Assigned to: @alert.AssignedOfficer.FullName</span>
                        }
                        @using (Html.BeginForm("ResolveAlert", "IoT", FormMethod.Post, new { style = "display:inline;" }))
                        {
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="alertId" value="@alert.AlertId" />
                            <button type="submit" class="btn btn-sm btn-outline-success">Resolve</button>
                        }
                    </li>
                }
            </ul>
        </div>
    }

    <!-- Bin Cards (Admin View - No Empty Bin Button) -->
    <div class="row mt-4">
        @foreach (var bin in Model)
        {
            var statusColor = bin.Status == "Online" ? "success" :
                             bin.Status == "Full" ? "danger" : "warning";

            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card shadow-sm">
                    <div class="card-header bg-@statusColor text-white">
                        <i class="fas fa-trash-alt"></i> @bin.BinName
                        <span class="badge bg-light text-dark float-end">@bin.Status</span>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">@bin.Location</p>
                        <div class="progress" style="height:25px;">
                            <div class="progress-bar bg-@statusColor"
                                 role="progressbar"
                                 style="width: @bin.FillLevel%">
                                @bin.FillLevel%
                            </div>
                        </div>
                        <div class="row mt-2 text-center small">
                            <div class="col-6">
                                <i class="fas fa-weight-hanging"></i> @bin.CurrentWeight.ToString("0.0") kg
                            </div>
                            <div class="col-6">
                                <i class="fas fa-battery-@(bin.BatteryLevel > 50 ? "full text-success" : "quarter text-warning")"></i>
                                @bin.BatteryLevel%
                            </div>
                        </div>
                        <div class="text-center mt-2">
                            <small class="text-muted">Updated: @bin.LastUpdated.ToString("HH:mm")</small>
                        </div>

                        <!-- ✅ Admin Actions -->
                        @if (User.IsInRole("Administrator"))
                        {
                            <div class="mt-2">
                                @if (bin.FillLevel >= 90)
                                {
                                    using (Html.BeginForm("SendAlert", "IoT", FormMethod.Post, new { style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="binId" value="@bin.BinId" />
                                        <input type="hidden" name="message" value="Bin is full. Please collect immediately." />
                                        <button type="submit" class="btn btn-sm btn-outline-danger w-100">
                                            <i class="fas fa-bell"></i> Send Alert
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No smart bins registered yet.
        </div>
    }

    <div class="mt-3">
        @Html.ActionLink("← Back to Dashboard", "Dashboard", "Admin", null, new { @class = "btn btn-secondary" })
    </div>
</div>

<script>
    function simulateData() {
        $.post('@Url.Action("SimulateData", "IoT")')
            .done(function() {
                location.reload();
            });
    }

    setInterval(function() {
        location.reload();
    }, 30000);
</script>