@model BinIT2WinIT.Models.SmartBin

@{
    ViewBag.Title = "Register Smart Bin";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg">
                <div class="card-header bg-success text-white">
                    <h4><i class="fas fa-plus-circle"></i> Register New Smart Bin</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("RegisterBin", "IoT", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.BinName, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.BinName, new { @class = "form-control", placeholder = "Enter bin name" })
                            @Html.ValidationMessageFor(m => m.BinName, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Location, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Location, new { @class = "form-control", placeholder = "Enter location" })
                            @Html.ValidationMessageFor(m => m.Location, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.DropOffPointId, "Drop-Off Point", new { @class = "form-label fw-bold" })
                            @Html.DropDownListFor(m => m.DropOffPointId, ViewBag.DropOffPoints as SelectList, "-- Select Drop-Off Point --", new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.DropOffPointId, "", new { @class = "text-danger" })
                        </div>

                        <div class="form-group mb-3">
                            @Html.LabelFor(m => m.Capacity, "Capacity (kg)", new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Capacity, new { @class = "form-control", type = "number", step = "5", min = "10" })
                            @Html.ValidationMessageFor(m => m.Capacity, "", new { @class = "text-danger" })
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <i class="fas fa-save"></i> Register Bin
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        @Html.ActionLink("← Back to IoT Dashboard", "Dashboard", "IoT", null, new { @class = "btn btn-secondary" })
    </div>
</div>