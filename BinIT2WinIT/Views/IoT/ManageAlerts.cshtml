@model List<BinIT2WinIT.Models.BinAlert>

@{
    ViewBag.Title = "Manage Alerts";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-bell text-warning"></i> Manage Alerts</h2>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Alert Stats -->
    <div class="row mt-3">
        <div class="col-md-4">
            <div class="card bg-danger text-white shadow">
                <div class="card-body text-center">
                    <h3>@Model.Count(a => a.AlertType == "Full")</h3>
                    <p>Full Bin Alerts</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body text-center">
                    <h3>@Model.Count(a => a.AlertType == "Maintenance")</h3>
                    <p>Maintenance Alerts</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white shadow">
                <div class="card-body text-center">
                    <h3>@Model.Count(a => a.AlertType == "Urgent")</h3>
                    <p>Urgent Alerts</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Alerts Table -->
    <div class="mt-4">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-bordered">
                    <thead class="bg-dark text-white">
                        <tr>
                            <th>Date</th>
                            <th>Bin</th>
                            <th>Type</th>
                            <th>Message</th>
                            <th>Assigned To</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var alert in Model)
                        {
                            <tr>
                                <td>@alert.CreatedAt.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@alert.SmartBin?.BinName ?? "Unknown"</td>
                                <td>
                                    <span class="badge @(alert.AlertType == "Full" ? "bg-warning" : alert.AlertType == "Maintenance" ? "bg-danger" : "bg-danger")">
                                        @alert.AlertType
                                    </span>
                                </td>
                                <td>@alert.Message</td>
                                <td>
                                    @if (alert.AssignedOfficer != null)
                                    {
                                        <span class="badge bg-info">@alert.AssignedOfficer.FullName</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Unassigned</span>
                                    }
                                </td>
                                <td>
                                    @using (Html.BeginForm("ResolveAlert", "IoT", FormMethod.Post, new { style = "display:inline;" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="alertId" value="@alert.AlertId" />
                                        <button type="submit" class="btn btn-sm btn-success">
                                            <i class="fas fa-check"></i> Resolve
                                        </button>
                                    }

                                    <!-- Assign Officer Dropdown -->
                                    @using (Html.BeginForm("AssignTempOfficer", "IoT", FormMethod.Post, new { style = "display:inline;", @class = "ms-1" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="binId" value="@alert.BinId" />
                                        <select name="tempOfficerId" class="form-select form-select-sm d-inline" style="width:120px;">
                                            <option value="">-- Assign --</option>
                                            @foreach (var officer in ViewBag.Officers as SelectList ?? new SelectList(new List<BinIT2WinIT.Models.CollectionOfficer>(), "OfficerId", "FullName"))
                                            {
                                                <option value="@officer.Value">@officer.Text</option>
                                            }
                                        </select>
                                        <input type="text" name="reason" placeholder="Reason" class="form-control form-control-sm d-inline" style="width:100px;" />
                                        <button type="submit" class="btn btn-sm btn-primary">
                                            <i class="fas fa-user-plus"></i> Assign
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> No active alerts. Everything is running smoothly!
            </div>
        }
    </div>

    <div class="mt-3">
        @Html.ActionLink("← Back to IoT Dashboard", "Dashboard", "IoT", null, new { @class = "btn btn-secondary" })
    </div>
</div>

@section Scripts {
    <script>
        // Auto-refresh every 30 seconds
        setInterval(function () {
            location.reload();
        }, 30000);
    </script>
}