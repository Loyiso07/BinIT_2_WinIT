@model List<BinIT2WinIT.Models.SmartBin>

@{
    ViewBag.Title = "My Bins";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <h2><i class="fas fa-trash-alt text-primary"></i> My Assigned Bins</h2>
    <p>Officer: <strong>@ViewBag.OfficerName</strong> | Location: <strong>@ViewBag.DropOffPointName</strong></p>
    <hr />

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats -->
    <div class="row mt-3">
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow">
                <div class="card-body text-center">
                    <h3>@Model.Count</h3>
                    <p>Total Assigned Bins</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-danger text-white shadow">
                <div class="card-body text-center">
                    <h3>@Model.Count(b => b.FillLevel >= 90)</h3>
                    <p>Full Bins (Need Collection)</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-dark shadow">
                <div class="card-body text-center">
                    <h3>@Model.Count(b => b.Status == "Warning" || b.Status == "Maintenance")</h3>
                    <p>Warning / Maintenance</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Bin Cards with Empty Bin Button -->
    <div class="row mt-4">
        @foreach (var bin in Model)
        {
            var statusColor = bin.FillLevel >= 90 ? "danger" :
                             bin.FillLevel >= 70 ? "warning" : "success";

            <div class="col-md-4 col-lg-3 mb-3">
                <div class="card shadow-sm">
                    <div class="card-header bg-@statusColor text-white">
                        <i class="fas fa-trash-alt"></i> @bin.BinName
                        <span class="badge bg-light text-dark float-end">@bin.Status</span>
                    </div>
                    <div class="card-body">
                        <p class="text-muted">@bin.Location</p>
                        <div class="progress" style="height:25px;">
                            <div class="progress-bar bg-@statusColor"
                                 role="progressbar"
                                 style="width: @bin.FillLevel%">
                                @bin.FillLevel%
                            </div>
                        </div>
                        <div class="row mt-2 text-center small">
                            <div class="col-6">
                                <i class="fas fa-weight-hanging"></i> @bin.CurrentWeight.ToString("0.0") kg
                            </div>
                            <div class="col-6">
                                <i class="fas fa-battery-@(bin.BatteryLevel > 50 ? "full text-success" : "quarter text-warning")"></i>
                                @bin.BatteryLevel%
                            </div>
                        </div>
                        <div class="text-center mt-2">
                            <small class="text-muted">Updated: @bin.LastUpdated.ToString("HH:mm")</small>
                        </div>

                        <!-- ✅ Empty Bin Button - Only for Officer -->
                        @if (bin.FillLevel >= 10)
                        {
                            <div class="mt-2">
                                @using (Html.BeginForm("EmptyBin", "IoT", FormMethod.Post, new { style = "display:inline;" }))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="binId" value="@bin.BinId" />
                                    <button type="submit" class="btn btn-sm btn-success w-100" onclick="return confirm('Empty this bin?')">
                                        <i class="fas fa-arrow-down"></i> Empty Bin
                                    </button>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="mt-2">
                                <button class="btn btn-sm btn-secondary w-100" disabled>
                                    <i class="fas fa-check"></i> Empty
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> No smart bins assigned to your location.
        </div>
    }

    <div class="mt-3">
        @Html.ActionLink("← Back to Dashboard", "Dashboard", "Officer", null, new { @class = "btn btn-secondary" })
    </div>
</div>

<script>
    setInterval(function () {
        location.reload();
    }, 30000);
</script>